<?xml version="1.0"?>
<Container version="2">
  <Name>caselog</Name>
  <Repository>ghcr.io/emdoc12/caselog:latest</Repository>
  <Registry>https://github.com/emdoc12/caselog</Registry>
  <Support>https://github.com/emdoc12/caselog/issues</Support>
  <Project>https://github.com/emdoc12/caselog</Project>
  <Overview>Case and earnings tracker for physician reviewers. Logs time per case and computes true effective hourly rate against each review organization's contract rates. Supports multiple review companies. Stores no PHI.</Overview>
  <Category>Productivity: Tools:Utilities</Category>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon>https://raw.githubusercontent.com/emdoc12/caselog/main/docs/icon.png</Icon>
  <Config Name="WebUI Port" Target="8080" Default="8321" Mode="tcp" Description="Web interface port" Type="Port" Display="always" Required="true">8321</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/caselog" Mode="rw" Description="Database and orgs.json" Type="Path" Display="always" Required="true">/mnt/user/appdata/caselog</Config>
  <Config Name="Timezone" Target="TZ" Default="America/New_York" Description="Timezone" Type="Variable" Display="always" Required="false">America/New_York</Config>
  <Config Name="Tax reserve %" Target="CASELOG_TAX_PCT" Default="30" Description="Percentage set aside for taxes" Type="Variable" Display="always" Required="false">30</Config>
</Container>
